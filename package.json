{
  "name": "imago-universe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Imago Universe - browser-based visual world building, environment composition and animation. Create worlds. Bring them to life.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "python3 tools/prepare_assets.py",
    "render-check": "tsx tools/render_check.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "mp4-muxer": "^5.2.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
